# The loaded .env selects one SDK family. CMake consumes it without discovery fallbacks.
list(PREPEND CMAKE_PREFIX_PATH "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
find_package(Threads REQUIRED)
find_package(
    SaltsBase "$ENV{SALTS_BASE_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_BASE_ROOT}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    CMeta "$ENV{CMETA_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{CMETA_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    SaltsUtils "$ENV{SALTS_UTILS_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    GmSSL CONFIG REQUIRED PATHS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    SaltsCNet "$ENV{SALTS_CORE_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_CORE_ROOT}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    Chttp "$ENV{CHTTP_VERSION}" EXACT CONFIG REQUIRED COMPONENTS App JWT PATHS "$ENV{CHTTP_ROOT}" NO_DEFAULT_PATH
                                                                 NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    xxHash CONFIG REQUIRED PATHS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)
find_package(
    TurboDB "$ENV{TURBODB_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{TURBODB_ROOT}" NO_DEFAULT_PATH
    NO_CMAKE_FIND_ROOT_PATH
)

if(APPLE)
    # TurboDB's ORM dylib loads DataBind via @rpath from the separate SaltsUtils SDK.
    list(APPEND CMAKE_BUILD_RPATH "$<TARGET_FILE_DIR:Salts::DataBind>")
endif()

if(FLOWIE_BUILD_CLUSTER)
    find_package(
        TurboRaft "$ENV{TURBORAFT_VERSION}" EXACT CONFIG REQUIRED PATHS "$ENV{TURBORAFT_ROOT}" NO_DEFAULT_PATH
        NO_CMAKE_FIND_ROOT_PATH
    )
endif()
