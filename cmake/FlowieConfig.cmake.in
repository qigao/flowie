@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(Flowie_FOUND FALSE)
  set(Flowie_NOT_FOUND_MESSAGE "SALTS_ROOT must name the installed Salts profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" FLOWIE_SALTS_ROOT_PATH)
find_dependency(Salts 1.8.3 EXACT CONFIG REQUIRED PATHS "${FLOWIE_SALTS_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
  set(Flowie_FOUND FALSE)
  set(Flowie_NOT_FOUND_MESSAGE "SALTS_UTILS_ROOT must name the installed SaltsUtils profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" FLOWIE_SALTS_UTILS_ROOT_PATH)
find_dependency(SaltsUtils 4.1.3 EXACT CONFIG REQUIRED PATHS "${FLOWIE_SALTS_UTILS_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT DEFINED ENV{HTTP_SERVICES_ROOT} OR "$ENV{HTTP_SERVICES_ROOT}" STREQUAL "")
  set(Flowie_FOUND FALSE)
  set(Flowie_NOT_FOUND_MESSAGE
      "HTTP_SERVICES_ROOT must name the installed Chttp profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{HTTP_SERVICES_ROOT}" FLOWIE_HTTP_SERVICES_ROOT_PATH)
if(NOT IS_DIRECTORY "${FLOWIE_HTTP_SERVICES_ROOT_PATH}")
  set(Flowie_FOUND FALSE)
  set(Flowie_NOT_FOUND_MESSAGE
      "HTTP_SERVICES_ROOT is not a directory: $ENV{HTTP_SERVICES_ROOT}")
  return()
endif()
find_dependency(Chttp 1.1.4 EXACT CONFIG REQUIRED PATHS "${FLOWIE_HTTP_SERVICES_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT DEFINED ENV{TURBODB_ROOT} OR "$ENV{TURBODB_ROOT}" STREQUAL "")
  set(Flowie_FOUND FALSE)
  set(Flowie_NOT_FOUND_MESSAGE "TURBODB_ROOT must name the installed TurboDB profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{TURBODB_ROOT}" FLOWIE_TURBODB_ROOT_PATH)
find_dependency(Orm 2.1.0 EXACT CONFIG REQUIRED PATHS "${FLOWIE_TURBODB_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/FlowieTargets.cmake")

set(Flowie_Protocol_FOUND TRUE)
set(Flowie_Client_FOUND TRUE)
set(Flowie_Flowie_FOUND TRUE)
check_required_components(Flowie)
