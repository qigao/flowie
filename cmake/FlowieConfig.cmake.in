@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(TurboUtils CONFIG REQUIRED)
find_dependency(TurboParser CONFIG REQUIRED)
find_dependency(TurboNet CONFIG REQUIRED)
find_dependency(Orm CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/FlowieTargets.cmake")

set(Flowie_Protocol_FOUND TRUE)
set(Flowie_Client_FOUND TRUE)
set(Flowie_Flowie_FOUND TRUE)
check_required_components(Flowie)
