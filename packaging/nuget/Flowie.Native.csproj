<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Flowie.Native</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.0.0</PackageVersion>
    <Authors>qigao</Authors>
    <Description>Flowie native MQTT server/client C/C++ SDK for Linux x64.</Description>
    <PackageTags>flowie;mqtt;broker;client;native;c;cpp;cmake</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/flowie</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/qigao/flowie</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Salts.Native" Version="[1.8.3]" />
    <PackageReference Include="SaltsUtils.Native" Version="[4.1.3]" />
    <PackageReference Include="CHttp.Native" Version="[1.1.4]" />
    <PackageReference Include="TurboDB.Native" Version="[1.0.0]" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
</Project>
