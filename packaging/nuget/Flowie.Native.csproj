<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Flowie.Native</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.0.1</PackageVersion>
    <Authors>qigao</Authors>
    <Description>Flowie native MQTT server/client C/C++ SDK for Linux x64, Windows x64, and Android arm64-v8a.</Description>
    <PackageTags>flowie;mqtt;broker;client;native;c;cpp;cmake;windows;android</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/flowie</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/qigao/flowie</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <SaltsNativeVersion Condition="'$(SaltsNativeVersion)' == ''">*</SaltsNativeVersion>
    <SaltsUtilsNativeVersion Condition="'$(SaltsUtilsNativeVersion)' == ''">*</SaltsUtilsNativeVersion>
    <CHttpNativeVersion Condition="'$(CHttpNativeVersion)' == ''">*</CHttpNativeVersion>
    <TurboDBNativeVersion Condition="'$(TurboDBNativeVersion)' == ''">*</TurboDBNativeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Salts.Native" Version="$(SaltsNativeVersion)" />
    <PackageReference Include="SaltsUtils.Native" Version="$(SaltsUtilsNativeVersion)" />
    <PackageReference Include="CHttp.Native" Version="$(CHttpNativeVersion)" />
    <PackageReference Include="TurboDB.Native" Version="$(TurboDBNativeVersion)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
</Project>
