    <div class="dataset-footer"><div class="pager" role="group" aria-label="ACL pagination"><span class="pager__status">{{policy_pager.count}} shown</span>{{#policy_pager.first}}<button type="button" class="button--quiet" hx-get="{{policy_pager.first_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">First page</button>{{/policy_pager.first}}{{^policy_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/policy_pager.first}}{{#policy_pager.more}}<button type="button" class="button--quiet" hx-get="{{policy_pager.more_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">Next page</button>{{/policy_pager.more}}{{^policy_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/policy_pager.more}}</div></div>
  </section>{{/show_acls}}

  {{#show_audit}}
  <section id="audit" class="dataset" aria-labelledby="audit-title">
    <div class="section-heading"><div><p class="eyebrow">Trace</p><h2 id="audit-title">Audit</h2></div><div class="dataset-toolbar" role="group" aria-label="Audit tools"><button type="button" class="button--quiet" popovertarget="audit-query">Query</button></div></div>
    <div id="audit-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Audit</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="audit-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Continue after cursor<input name="audit_after" required inputmode="numeric"></label><button type="button" hx-get="{{audit_pager.query_url}}" hx-include="closest .query-panel" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML" hx-disabled-elt="this">Query audit</button></div></div>
    <div class="table-wrap"><table><thead><tr><th>Actor</th><th>Operation</th><th>Target</th></tr></thead><tbody>{{#audits}}<tr><td>{{actor}}</td><td>{{operation}}</td><td>{{target_id}}</td></tr>{{/audits}}{{^audits}}<tr><td colspan="3" class="empty">No audit entries yet.</td></tr>{{/audits}}</tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="Audit pagination"><span class="pager__status">{{audit_pager.count}} shown</span>{{#audit_pager.first}}<button type="button" class="button--quiet" hx-get="{{audit_pager.first_url}}" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML">First page</button>{{/audit_pager.first}}{{^audit_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/audit_pager.first}}{{#audit_pager.more}}<button type="button" class="button--quiet" hx-get="{{audit_pager.more_url}}" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML">Next page</button>{{/audit_pager.more}}{{^audit_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/audit_pager.more}}</div></div>
  </section>
  {{/show_audit}}
  </div>
</div>
