<div class="dashboard__inner">
  <nav class="dashboard-nav" aria-label="Control sections">
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">{{#is_platform_workspace}}Platform{{/is_platform_workspace}}{{#is_domain_workspace}}Domain{{/is_domain_workspace}}</p>
      <a href="{{overview_path}}"{{#is_overview}} aria-current="page"{{/is_overview}}>Overview</a>
      <a href="{{integration_path}}"{{#is_integration}} aria-current="page"{{/is_integration}}>{{#is_platform_workspace}}Configuration{{/is_platform_workspace}}{{#is_domain_workspace}}Integration{{/is_domain_workspace}}</a>
    </div>
    {{#is_domain_workspace}}<div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Identity</p>
      <a href="{{users_path}}"{{#is_users}} aria-current="page"{{/is_users}}>Users</a>
    </div>
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Access</p>
      <a href="{{groups_path}}"{{#is_groups}} aria-current="page"{{/is_groups}}>Groups</a>
      <a href="{{roles_path}}"{{#is_roles}} aria-current="page"{{/is_roles}}>Roles</a>
      <a href="{{acls_path}}"{{#is_acls}} aria-current="page"{{/is_acls}}>ACL rules</a>
    </div>{{/is_domain_workspace}}
    {{#can_audit_read}}<div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Governance</p>
      {{#can_audit_read}}<a href="{{audit_path}}"{{#is_audit}} aria-current="page"{{/is_audit}}>Audit</a>{{/can_audit_read}}
    </div>{{/can_audit_read}}
  </nav>

  <div class="dashboard__content">
  <section class="workspace-context" data-workspace-kind="{{#is_platform_workspace}}platform{{/is_platform_workspace}}{{#is_domain_workspace}}domain{{/is_domain_workspace}}" aria-labelledby="workspace-context-title">
    <div class="workspace-context__identity">
      <p class="eyebrow">Current scope</p>
      <div class="workspace-context__title">
        <h2 id="workspace-context-title">{{#is_platform_workspace}}Platform{{/is_platform_workspace}}{{#is_domain_workspace}}Domain{{/is_domain_workspace}}</h2>
        <code>{{domain_id}}</code>
      </div>
      <p>{{#is_platform_workspace}}Monitor the control plane, review runtime configuration, and manage Domain lifecycle. Domain-owned identities and policy remain outside this scope.{{/is_platform_workspace}}{{#is_domain_workspace}}Users, access policy, audit records and integration settings on this page belong only to this Domain.{{/is_domain_workspace}}</p>
    </div>
  </section>
  <div id="dashboard-feedback" class="feedback" aria-live="polite"></div>
  {{#credential_issued}}<section class="credential-secret" data-credential-secret tabindex="-1" aria-labelledby="credential-secret-title" aria-describedby="credential-secret-guidance">
    <div class="credential-secret__heading"><div><p class="eyebrow">Service credential</p><h2 id="credential-secret-title">New token ready</h2></div><button type="button" class="button--quiet" data-dismiss-credential>Dismiss token</button></div>
    <dl class="credential-secret__identity"><div><dt>Domain</dt><dd>{{credential_domain}}</dd></div><div><dt>Service ID</dt><dd>{{credential_principal}}</dd></div></dl>
    <p id="credential-secret-guidance">Copy this token now. It will not be shown again. Issuing another token immediately invalidates this one.</p>
    <div class="credential-secret__value"><code data-credential-token tabindex="0">{{credential_token}}</code><button type="button" data-copy-credential>Copy token</button></div>
    <output class="credential-secret__status" data-credential-copy-status aria-live="polite"></output>
  </section>{{/credential_issued}}
  <template id="user-picker-options">{{#user_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{principal_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{principal_id}}</span><small>{{principal_type}}</small></button>{{/user_options}}{{^user_options}}<p class="empty">No users yet. Create a user to assign access.</p>{{/user_options}}</template>
  <template id="group-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups yet. Create a group to organize access.</p>{{/group_options}}</template>
  <template id="group-member-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{#add_disabled}} disabled{{/add_disabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups available for membership.</p>{{/group_options}}</template>
  <template id="group-parent-picker-options"><button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{domain_id}}" role="option" aria-selected="false" tabindex="-1"><span>{{domain_id}}</span><small>Domain</small></button>{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{#parent_disabled}} disabled{{/parent_disabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups yet. Create a group to organize access.</p>{{/group_options}}</template>
  <template id="role-picker-options">{{#role_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{role_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{role_id}}</span><small>Role</small></button>{{/role_options}}{{^role_options}}<p class="empty">No roles yet. Create a role to assign permissions.</p>{{/role_options}}</template>
  <template id="acl-builder-template">
    <div class="acl-builder" data-acl-builder>
      <div class="acl-builder__grid">
        <label>Subject type<select data-acl-subject-kind><option value="user">User</option><option value="role">Role</option><option value="group">Group</option></select></label>
        <label data-acl-subject-field="user">User<select data-acl-subject="user" required><option value="">Select user</option>{{#user_options}}<option value="{{principal_id}}"{{^enabled}} disabled{{/enabled}}>{{principal_id}}</option>{{/user_options}}</select></label>
        <label data-acl-subject-field="role" hidden>Role<select data-acl-subject="role" disabled><option value="">Select role</option>{{#role_options}}<option value="{{role_id}}"{{^enabled}} disabled{{/enabled}}>{{role_id}}</option>{{/role_options}}</select></label>
        <label data-acl-subject-field="group" hidden>Group<select data-acl-subject="group" disabled><option value="">Select group</option>{{#group_options}}<option value="{{group_id}}"{{^enabled}} disabled{{/enabled}}>{{group_id}}</option>{{/group_options}}</select></label>
        <label>Connection<select data-acl-connection><option value="allow">Allow connection</option><option value="deny">Deny connection</option></select></label>
        <label class="acl-builder__entries">Topic permissions<textarea data-acl-entries rows="8" maxlength="16000" spellcheck="false" placeholder="write topic {{domain_id}}/telemetry/%u/{event,heartbeat}"></textarea><small>One statement per line. Read permits subscriptions; write permits publishing. Use %u for MQTT username and %c for client ID in any complete segment.</small></label>
      </div>
      <div class="acl-preview"><span>Canonical document</span><output data-acl-preview></output></div>
      <input type="hidden" name="rule_document" data-acl-rule required>
    </div>
  </template>

  {{#show_overview}}<section id="overview" class="summary" aria-labelledby="summary-title">
    <div class="section-heading">
      <div><p class="eyebrow">Current state</p><h2 id="summary-title">{{#is_platform_workspace}}Platform overview{{/is_platform_workspace}}{{#is_domain_workspace}}Policy overview{{/is_domain_workspace}}</h2></div>
      <div class="dataset-toolbar">
        <span class="scope">{{#is_platform_workspace}}Platform operator{{/is_platform_workspace}}{{#is_domain_workspace}}Domain: {{domain_id}}{{/is_domain_workspace}} · User: {{actor}}</span>
        {{#can_create_domain}}<button type="button" class="button--quiet" popovertarget="domain-admin-initialize">Initialize admin</button><button type="button" popovertarget="domain-add">Add domain</button>{{/can_create_domain}}
      </div>
    </div>
    {{#can_create_domain}}<div id="domain-add" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Domains</p><h3>Create a domain</h3></div><button type="button" class="button--close" popovertarget="domain-add" popovertargetaction="hide" aria-label="Close" title="Close"></button></div>
      <p class="task-hint">Create the isolation boundary here. Domain-owned identities and access policy are managed by that Domain's administrator.</p>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="domain.create">
        <label>Domain ID<input name="domain_id" required maxlength="255" autocomplete="off"></label>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create domain</button>
      </div>
    </div>{{/can_create_domain}}
    {{#can_create_domain}}<div id="domain-admin-initialize" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Domain lifecycle</p><h3>Initialize Domain admin</h3></div><button type="button" class="button--close" popovertarget="domain-admin-initialize" popovertargetaction="hide" aria-label="Close" title="Close"></button></div>
      <p class="task-hint">Creates or resumes the first human security administrator. The initial password must be changed at first sign-in.</p>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="domain.admin.initialize">
        <label>Domain ID<input name="domain_id" required maxlength="255" autocomplete="off"></label>
        <label>Administrator ID<input name="principal_id" required maxlength="255" autocomplete="username"></label>
        <label>Initial password<input type="password" name="new_password" required minlength="16" maxlength="255" autocomplete="new-password"></label>
        <label>Confirm password<input type="password" name="confirm_password" required minlength="16" maxlength="255" autocomplete="new-password"></label>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Initialize administrator</button>
      </div>
    </div>{{/can_create_domain}}
    {{#is_platform_workspace}}<aside class="onboarding" aria-labelledby="domain-lifecycle-title">
      <div class="onboarding__heading"><p class="eyebrow">Isolation boundaries</p><h3 id="domain-lifecycle-title">Domain lifecycle</h3><p>The Platform can create and enumerate Domains, but it cannot enter their users, roles, groups, ACL rules, integrations, or audit records.</p></div>
      <ul class="domain-list">{{#domains}}<li><code>{{domain_id}}</code></li>{{/domains}}{{^domains}}<li class="empty">No Domains created yet.</li>{{/domains}}</ul>
    </aside>{{/is_platform_workspace}}
    {{#is_domain_workspace}}<dl class="metrics">
      <div><dt>Policy version</dt><dd>{{policy_version}}</dd></div>
      <div><dt>Draft rules</dt><dd>{{draft_rule_count}}</dd></div>
      <div><dt>Published rules</dt><dd>{{published_rule_count}}</dd></div>
    </dl>{{/is_domain_workspace}}
  </section>{{/show_overview}}

  {{#show_integration}}<section id="integration" class="dataset integration-page" aria-labelledby="integration-title">
    <div class="section-heading">
      <div><p class="eyebrow">{{#is_platform_workspace}}Runtime{{/is_platform_workspace}}{{#is_domain_workspace}}Backend connectivity{{/is_domain_workspace}}</p><h2 id="integration-title">{{#is_platform_workspace}}Platform configuration{{/is_platform_workspace}}{{#is_domain_workspace}}Integration{{/is_domain_workspace}}</h2></div>
      <span class="scope">{{#is_platform_workspace}}Platform{{/is_platform_workspace}}{{#is_domain_workspace}}Domain: {{domain_id}}{{/is_domain_workspace}}</span>
    </div>
    <p class="section-intro">{{#is_platform_workspace}}Review the effective Management endpoint and copy configuration for platform automation. Runtime edits and process restarts remain with the deployment supervisor.{{/is_platform_workspace}}{{#is_domain_workspace}}Connect one backend to the current Domain through the authenticated Management RPC endpoint. Credentials stay server-side and are never embedded in this page.{{/is_domain_workspace}}</p>
    <section class="setup-console" aria-labelledby="integration-setup-title" data-integration-setup data-rpc-path="{{rpc_path}}" data-domain="{{domain_id}}">
      <div class="setup-console__intro">
        <p class="eyebrow">Quick setup</p>
        <h3 id="integration-setup-title">{{#is_platform_workspace}}Management RPC{{/is_platform_workspace}}{{#is_domain_workspace}}Connect your backend{{/is_domain_workspace}}</h3>
        <p>Use the current Control origin and runtime RPC path. Authenticate from your service, keep the bearer session private, then send JSON-RPC 2.0 requests.</p>
      </div>
      <div class="setup-console__body">
        <ol class="setup-steps" aria-label="Integration setup steps">
          <li><span>1</span><div><strong>Sign in</strong><small>POST the domain, principal and password to <code>/v2/control/login</code>.</small></div></li>
          <li><span>2</span><div><strong>Store the session</strong><small>Keep the returned bearer token in the backend only.</small></div></li>
          <li><span>3</span><div><strong>Call Management RPC</strong><small>Send JSON-RPC 2.0 to the endpoint below.</small></div></li>
        </ol>
        <div class="setup-values">
          <div class="setup-value">
            <span>RPC endpoint</span>
            <code id="integration-rpc-endpoint" data-runtime-endpoint>{{rpc_path}}</code>
            <button type="button" class="button--quiet button--copy" data-copy-target="integration-rpc-endpoint" aria-label="Copy RPC endpoint" aria-describedby="integration-copy-status">Copy</button>
          </div>
          <div class="setup-value">
            <span>Current domain</span>
            <code>{{domain_id}}</code>
          </div>
        </div>
        <details class="setup-config">
          <summary>Integration configuration</summary>
          <p>Start with environment variables, then load them into your service configuration. No credential is written to this page.</p>
          <pre><code id="integration-config" data-runtime-config>FLOWIE_CONTROL_BASE_URL=https://control.example.com
FLOWIE_CONTROL_LOGIN_PATH=/v2/control/login
FLOWIE_CONTROL_RPC_PATH={{rpc_path}}
FLOWIE_CONTROL_DOMAIN={{domain_id}}</code></pre>
          <button type="button" class="button--secondary button--copy" data-copy-target="integration-config" aria-label="Copy integration configuration" aria-describedby="integration-copy-status">Copy configuration</button>
        </details>
        <output id="integration-copy-status" role="status" aria-live="polite"></output>
      </div>
    </section>
  </section>{{/show_integration}}

  {{#show_users}}<section id="users" class="dataset" aria-labelledby="users-title">
    <div class="section-heading">
      <div><p class="eyebrow">Directory</p><h2 id="users-title">Users</h2></div>
      <div class="dataset-toolbar" role="group" aria-label="Users tools">
        <button type="button" class="button--quiet" popovertarget="users-query">Query</button>
        {{#can_user_admin}}<button type="button" popovertarget="users-add">Add</button>{{/can_user_admin}}
      </div>
    </div>
    <div id="users-query" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="users-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="query-panel">
        <label>Start after user ID<input name="users_after" required maxlength="255"></label>
        <button type="button" hx-get="{{users_pager.query_url}}" hx-include="closest .query-panel" hx-select="#users" hx-target="#users" hx-swap="outerHTML" hx-disabled-elt="this">Query users</button>
      </div>
    </div>
    {{#can_user_admin}}
    <div id="users-add" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Add user</h3></div><button type="button" class="button--close" popovertarget="users-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="user.create">
        <label>User ID<input name="principal_id" required maxlength="255"></label>
        <label>Type<input name="principal_type" list="principal-types" required maxlength="63" placeholder="service"></label>
        <datalist id="principal-types"><option value="service"></option><option value="device"></option><option value="human"></option></datalist>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add user</button>
      </div>
    </div>
    {{/can_user_admin}}
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Type</th><th>Status</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#users}}<tr><td>{{principal_id}}</td><td>{{principal_type}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td class="table-actions">
        {{#can_security_admin}}{{#is_human}}{{#enabled}}<button type="button" class="button--quiet" popovertarget="human-password-{{row_index}}">Set password</button>{{/enabled}}{{/is_human}}{{/can_security_admin}}
        {{#can_security_admin}}{{#is_service}}{{#enabled}}<button type="button" class="button--quiet" popovertarget="service-token-{{row_index}}">Issue token</button><button type="button" class="button--quiet button--danger-text" popovertarget="service-token-revoke-{{row_index}}">Revoke token</button>{{/enabled}}{{/is_service}}{{/can_security_admin}}
        {{#can_manage_access}}<button type="button" class="button--quiet" popovertarget="user-access-{{row_index}}">Manage access</button>{{/can_manage_access}}
        {{#can_user_admin}}{{#enabled}}<button type="button" class="button--quiet button--danger-text" popovertarget="user-delete-{{row_index}}">Delete</button>{{/enabled}}{{^enabled}}<button type="button" class="button--quiet" disabled>Delete</button>{{/enabled}}{{/can_user_admin}}
        {{^can_manage_access}}{{^can_user_admin}}<span class="muted">View only</span>{{/can_user_admin}}{{/can_manage_access}}
        {{#can_manage_access}}
        <div id="user-access-{{row_index}}" class="control-popover control-popover--wide" popover>
          <div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Manage user access</h3></div><button type="button" class="button--close" popovertarget="user-access-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
          <p class="task-hint">Choose a group or role from the directory, review the selection, then apply the required action.</p>
          <div class="command-grid">
            {{#can_user_admin}}<section class="access-task" data-entity-picker><h4>Group membership</h4><p class="muted">Membership inherits access from parent groups.</p><div class="entity-picker__pane"><h4>Group tree</h4><div class="entity-picker__list" data-picker-options="group-member-picker-options" role="listbox" aria-label="Group tree"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No group selected</output><div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.add"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add to group</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.remove"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove from group</button></div></div></section>{{/can_user_admin}}
            {{#can_security_admin}}<section class="access-task" data-entity-picker><h4>Role assignment</h4><p class="muted">Roles grant the permissions defined by ACL rules.</p><div class="entity-picker__pane"><h4>Available roles</h4><div class="entity-picker__list" data-picker-options="role-picker-options" role="listbox" aria-label="Available roles"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No role selected</output>{{#role_options_truncated}}<p class="notice-inline">Only the first 100 roles are available.</p>{{/role_options_truncated}}<div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.assign"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Assign role</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.remove"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove role</button></div></div></section>{{/can_security_admin}}
          </div>
        </div>
        {{/can_manage_access}}
        {{#can_security_admin}}{{#is_human}}{{#enabled}}<div id="human-password-{{row_index}}" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Set human password</h3></div><button type="button" class="button--close" popovertarget="human-password-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close"></button></div><p class="task-hint"><code>create</code> sets the first password; <code>replace</code> explicitly invalidates the existing password. The password is never returned by Control.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="password.set"><input type="hidden" name="principal_id" value="{{principal_id}}"><label>Operation<select name="mode" required><option value="" selected disabled>Choose operation</option><option value="create">Set first password</option><option value="replace">Replace existing password</option></select></label><label>New password<input type="password" name="new_password" required minlength="16" maxlength="4096" autocomplete="new-password"></label><label>Confirm password<input type="password" name="confirm_password" required minlength="16" maxlength="4096" autocomplete="new-password"></label><input type="hidden" name="request_id" data-request-id><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Save password</button></div></div>{{/enabled}}{{/is_human}}{{/can_security_admin}}
