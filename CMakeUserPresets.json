{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "ci-native-common",
      "hidden": true,
      "inherits": "vcpkg-cache-ci",
      "binaryDir": "${sourceDir}/build/native-ci",
      "environment": {
        "PKG_ROOT": "$penv{RUNNER_TEMP}/flowie-sdk",
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "HTTP_SERVICES_ROOT": "$penv{HTTP_SERVICES_ROOT}",
        "TURBODB_ROOT": "$penv{TURBODB_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie/release",
        "FLOWIE_BUILD_TESTS": "ON",
        "FLOWIE_BUILD_CONTROL": "ON",
        "FLOWIE_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "ci-win-release-user",
      "inherits": [
        "ci-native-common",
        "release-win-msvc-ninja"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "$penv{QIGAO_VCPKG_WINDOWS_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$penv{QIGAO_VCPKG_WINDOWS_HOST_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$penv{QIGAO_VCPKG_WINDOWS_TRIPLET}"
      },
      "environment": {
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/native-ci/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$penv{QIGAO_VCPKG_WINDOWS_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{HTTP_SERVICES_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{TURBODB_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "ci-linux-release-user",
      "inherits": [
        "ci-native-common",
        "release-linux-ninja"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux"
      },
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/native-ci/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{HTTP_SERVICES_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "vcpkg-cache-ci",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
      }
    },
    {
      "name": "vcpkg-cache-linux",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
      }
    },
    {
      "name": "vcpkg-cache-windows",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
      }
    },
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "RE2C_ROOT": "$penv{RE2C_ROOT}",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "C:/projects/cpp",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "C:/tools/vcpkg",
        "USER_ROOT": "C:/Users/lockg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-windows"
      ]
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "OPENSSL_ROOT_DIR": "$env{VCPKG_INSTALLED_DIR}/x64-windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "environment": {
        "PKG_ROOT": "/opt",
        "VCPKG_ROOT": "/opt/vcpkg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-linux"
      ]
    },
    {
      "name": "android-win-environment",
      "hidden": true,
      "inherits": "win-toolchain",
      "environment": {
        "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
        "ANDROID_NDK_VERSION": "28.2.13676358",
        "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
      }
    },
    {
      "name": "android-win-user-paths",
      "hidden": true,
      "inherits": [
        "vcpkg-cache-windows",
        "android-win-paths",
        "ISWindows"
      ],
      "cacheVariables": {
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": [
        "base-win-dev-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/debug",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{HTTP_SERVICES_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{TURBODB_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie/debug"
      }
    },
    {
      "name": "win-release-user",
      "inherits": [
        "base-win-release-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/release",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{HTTP_SERVICES_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{TURBODB_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie/release"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": [
        "base-linux-dev-user",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/debug",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{HTTP_SERVICES_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie/debug"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": [
        "release-linux-ninja",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb/release",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{HTTP_SERVICES_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{TURBODB_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie/release"
      }
    },
    {
      "name": "linux-sdk-package",
      "inherits": [
        "linux-release-user"
      ],
      "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_TESTS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "android-dependencies-debug",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services-android/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb-android/debug"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie-android/debug"
      }
    },
    {
      "name": "android-dependencies-release",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
        "HTTP_SERVICES_ROOT": "$env{PKG_ROOT}/http-services-android/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
        "TURBODB_ROOT": "$env{PKG_ROOT}/turbodb-android/release"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/flowie-android/release"
      }
    },
    {
      "name": "android-arm64-v8a-debug-win",
      "inherits": [
        "android-arm64-v8a-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-arm64-v8a-release-win",
      "inherits": [
        "android-arm64-v8a-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-debug-win",
      "inherits": [
        "android-x86_64-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-release-win",
      "inherits": [
        "android-x86_64-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-debug-win",
      "inherits": [
        "android-x86-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-release-win",
      "inherits": [
        "android-x86-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    }
  ],
