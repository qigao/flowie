#include <windows.h>
#include "ui/connection_resource.h"

1 24 "workbench.manifest"

IDD_NEW_CONNECTION DIALOGEX 0, 0, 322, 287
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New MQTT Connection"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Recent connections", -1, 12, 13, 82, 12
    COMBOBOX IDC_RECENT_CONNECTION, 104, 10, 206, 113, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "&Host", -1, 12, 39, 34, 12
    EDITTEXT IDC_BROKER_HOST, 104, 36, 120, 15, ES_AUTOHSCROLL
    LTEXT "&Port", -1, 230, 39, 27, 12
    EDITTEXT IDC_BROKER_PORT, 260, 36, 50, 15, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "&Transport", -1, 12, 61, 86, 12
    COMBOBOX IDC_BROKER_TRANSPORT, 104, 58, 206, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&MQTT version", -1, 12, 83, 86, 12
    COMBOBOX IDC_BROKER_PROTOCOL, 104, 80, 206, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&WebSocket path", -1, 12, 105, 86, 12
    EDITTEXT IDC_BROKER_PATH, 104, 102, 206, 15, ES_AUTOHSCROLL
    LTEXT "&Username", -1, 12, 127, 86, 12
    EDITTEXT IDC_BROKER_USER, 104, 124, 206, 15, ES_AUTOHSCROLL
    LTEXT "Pass&word", -1, 12, 149, 86, 12
    EDITTEXT IDC_BROKER_PASSWORD, 104, 146, 206, 15, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "CA &file", -1, 12, 171, 86, 12
    EDITTEXT IDC_BROKER_CA, 104, 168, 206, 15, ES_AUTOHSCROLL
    LTEXT "Client c&ertificate", -1, 12, 193, 86, 12
    EDITTEXT IDC_BROKER_CERT, 104, 190, 206, 15, ES_AUTOHSCROLL
    LTEXT "Client &key", -1, 12, 215, 86, 12
    EDITTEXT IDC_BROKER_KEY, 104, 212, 206, 15, ES_AUTOHSCROLL

    LTEXT "", IDC_CONNECTION_ERROR, 12, 234, 298, 19
    DEFPUSHBUTTON "&Connect", IDOK, 104, 257, 64, 19
    PUSHBUTTON "&Open tab", IDC_OPEN_CONNECTION_TAB, 175, 257, 64, 19
    PUSHBUTTON "Cancel", IDCANCEL, 246, 257, 64, 19
END

IDD_SAVE_REQUEST DIALOGEX 0, 0, 300, 162
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save Request"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Collection", -1, 12, 14, 72, 12
    COMBOBOX IDC_SAVE_COLLECTION, 89, 11, 199, 88, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Request &name", -1, 12, 37, 72, 12
    EDITTEXT IDC_SAVE_REQUEST_NAME, 89, 34, 199, 15, ES_AUTOHSCROLL
    LTEXT "N&otes", -1, 12, 61, 72, 12
    EDITTEXT IDC_SAVE_REQUEST_NOTES, 89, 58, 199, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT "Broker credentials and WebSocket query parameters are excluded.", IDC_SAVE_REQUEST_HINT, 12, 107, 276, 12
    LTEXT "", IDC_SAVE_REQUEST_ERROR, 12, 121, 276, 12
    DEFPUSHBUTTON "&Save", IDOK, 155, 138, 62, 16
    PUSHBUTTON "Cancel", IDCANCEL, 226, 138, 62, 16
END
