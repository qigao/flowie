# Copy the selected fields into .env and set shared installation paths for this machine.
# .env is the sole source of non-secret build configuration; CMake consumes its loaded environment.
# CI uses the release versions and Windows OpenWTL digest below, and sets paths for its runner.
# Restore updates SDK roots in .env while preserving credentials and other machine settings.
VCPKG_CACHE_VERSION=0.1.3
VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache
SALTS_BASE_VERSION=0.1.8
CMETA_VERSION=0.1.8
SALTS_CORE_VERSION=0.1.16
SALTS_UTILS_VERSION=0.1.6
CHTTP_VERSION=0.1.2
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
# Windows Workbench GUI source, verified by CMake FetchContent.
OPENWTL_VERSION=0.1.2
OPENWTL_SHA256=9fbe6cc68d23ee37bbd4ae4e2a54f64b4d428f2837f0d557687d9551fde485bd
VCPKG_TARGET_TRIPLET=qigao-x64-windows-llvm-mingw
CMAKE_BUILD_PARALLEL_LEVEL=3
# Shared vcpkg-cache owns vcpkg/re2c/Lemon restoration and release declarations.
# Select its restored roots in .env; Flowie does not maintain duplicate lock files.
# VCPKG_INSTALLED_DIR=C:/shared/vcpkg-cache/payload/vcpkg_installed
# SHARED_DEPENDENCY_ROOT=C:/shared/native
# RE2C_ROOT=C:/shared/re2c/tools/windows-x64
# LEMON_ROOT=C:/shared/lemon/tools/windows-x64
# VCPKG_BINARY_SOURCES=clear;default,readwrite
# Restore selects versioned SDK destinations under build/dependencies and verifies receipts.
# TurboDB restoration uses the exact TURBODB_VERSION and matching compiler profile.
# Chttp 0.1.2 uses the matching split SDK releases selected above.
# TURBORAFT_ROOT=C:/sdk/turboraft-0.3.2
# Supply GITHUB_TOKEN in the parent environment (an authenticated gh login can supply it).
SALTS_CNET_VERSION=0.1.16
TURBORAFT_VERSION=0.3.2
TURBODB_VERSION=0.1.2
