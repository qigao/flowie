{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/TestPresets.json",
        "presets/AndroidPresets.json"
    ],
    "configurePresets": [
    {
      "name": "ci-release-options",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_MODE": "ON",
        "FLOWIE_BUILD_TESTS": "ON",
        "BUILD_TESTS": "ON",
        "FLOWIE_BUILD_CONTROL": "ON",
        "FLOWIE_BUILD_SERVER": "ON",
        "FLOWIE_BUILD_CLUSTER": "OFF",
        "FLOWIE_MQTT_PUBLIC_LIVE_TESTS": "OFF",
        "FLOWIE_TURBODB_LIVE_TESTS": "OFF",
        "FLOWIE_MQTT_FIXED_INTEROP_TESTS": "OFF",
        "FLOWIE_MQTT_SOAK_TESTS": "OFF",
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_SANITIZER_UNDEFINED": "OFF"
      }
    },
    {
      "name": "ci-base-sdk-options",
      "hidden": true,
      "inherits": "ci-release-options",
      "cacheVariables": {
        "FLOWIE_BUILD_TESTS": "OFF",
        "BUILD_TESTS": "OFF",
        "FLOWIE_BUILD_CONTROL": "OFF",
        "FLOWIE_BUILD_SERVER": "OFF",
        "FLOWIE_BUILD_CLUSTER": "OFF"
      }
    },
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        }
    ]
}
